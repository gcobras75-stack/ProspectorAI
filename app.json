{
  "expo": {
    "name": "ProspectorAI",
    "slug": "ProspectorAI",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "prospectorai",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.ecapro.prospectorai",
      "config": {
        "usesNonExemptEncryption": false
      },
      "infoPlist": {
        "NSCameraUsageDescription": "Permite escanear rocas con la IA usando los lentes macro y filtros UV.",
        "NSPhotoLibraryUsageDescription": "Permite analizar muestras guardadas en la galería.",
        "NSLocationWhenInUseUsageDescription": "Permite registrar las coordenadas geológicas exactas de la muestra recolectada.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "Permite monitorear tu ubicación en el terreno para el mapa de calor mineral."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      "expo-sqlite",
      "expo-build-properties",
      [
        "expo-image-picker",
        {
          "photosPermission": "Permite cargar evidencias.",
          "cameraPermission": "Permite realizar capturas crudas en campo para pasar por el filtro IA."
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Requerido para el trazado de prospección en altitud."
        }
      ]
    ],
    "updates": {
      "enabled": true,
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0,
      "url": "https://u.expo.dev/d95e10b8-82f0-44d8-935a-7059989e4e54"
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "d95e10b8-82f0-44d8-935a-7059989e4e54"
      }
    },
    "owner": "duendexx"
  }
}
